#!/bin/bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export DEVELOPER_DIR="${DEVELOPER_DIR:-/Library/Developer/CommandLineTools}"
SCRATCH="${SCRATCH_PATH:-$ROOT/.build}"
TOOLCHAIN_USR="$(dirname "$(dirname "$(xcrun --find swiftc)")")"
PLUGINS="$TOOLCHAIN_USR/lib/swift/host/plugins/testing"
ARGS=(test --package-path "$ROOT" --scratch-path "$SCRATCH")
if [[ -d "$PLUGINS" ]]; then
    ARGS+=(-Xswiftc -plugin-path -Xswiftc "$PLUGINS")
fi

LOG="$(mktemp -t toy-box-test)"
trap 'rm -f "$LOG"' EXIT
xcrun swift "${ARGS[@]}" "$@" 2>&1 | tee "$LOG"

# A test process can stop partway and still exit 0, for example when a WindowServer event stops
# the main run loop under an async main. Its run then never prints a summary, so every run that
# started must have finished with one.
count() { grep -cE "$1" "$LOG" || true; }
started=$(count 'Test run started\.')
finished=$(count 'Test run with [0-9]+ tests? .*(passed|failed) after ')
suites_started=$(count "Test Suite '(All|Selected) tests' started")
suites_finished=$(count "Test Suite '(All|Selected) tests' (passed|failed)")
if (( started != finished || suites_started != suites_finished )); then
    echo "error: a test run stopped before printing its summary, so its remaining tests never ran" \
        "(Swift Testing $finished of $started finished, XCTest $suites_finished of $suites_started)" >&2
    exit 1
fi
