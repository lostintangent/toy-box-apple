#!/bin/bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export DEVELOPER_DIR=/Library/Developer/CommandLineTools
SDK="$(xcrun --sdk macosx --show-sdk-path)"
CONFIG="${CONFIGURATION:-debug}"
# Parallel builders each pass their own SCRATCH_PATH so SwiftPM builds never share a directory.
SCRATCH="${SCRATCH_PATH:-$ROOT/.build}"

swift build --package-path "$ROOT" --scratch-path "$SCRATCH" --configuration "$CONFIG" --sdk "$SDK"
BIN="$(swift build --package-path "$ROOT" --scratch-path "$SCRATCH" --configuration "$CONFIG" --sdk "$SDK" --show-bin-path)"
APP="$SCRATCH/Toy Box Channels.app"
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
cp "$BIN/ToyBoxChannels" "$APP/Contents/MacOS/ToyBoxChannels"
cp "$ROOT/Resources/Info.plist" "$APP/Contents/Info.plist"
codesign --force --deep --sign - "$APP"
echo "$APP"
if [[ "${1:-}" != "--no-open" ]]; then
    open -n "$APP"
fi
