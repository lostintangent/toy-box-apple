#!/bin/bash
# Builds a release bundle and measures it against script/perf-demo.mjs, with a fresh fixture and app
# instance for each scenario, then prints every result beside its budget.
# Usage: SCRATCH_PATH=/tmp/tbm-<you> script/benchmark [launch|switch|messages|paging|idle ...]
# Without scenarios it runs launch, switch, messages and paging. idle takes a minute, so it runs only
# when named. The benchmark window opens in front without taking focus. Keep it uncovered while it
# runs. Exits 1 when a result is over budget or a scenario fails.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SCRATCH="${SCRATCH_PATH:?Set SCRATCH_PATH=/tmp/tbm-<you>}"
# A sibling scratch path keeps the release build from replacing the debug one.
BUILD="${SCRATCH%/}-benchmark"
REFERENCE="${TOY_BOX_REFERENCE:-$ROOT/../toy-box-Minecraft}"
PORT="${TOY_BOX_PERF_PORT:-3292}"
SERVER="http://127.0.0.1:$PORT"
NAME="Toy Box Desktop Benchmark"
ID="dev.toybox.channels.mac.benchmark"
APP="$BUILD/$NAME.app"
BIN="$APP/Contents/MacOS/ToyBoxDesktop"

SCENARIOS=("$@")
if [[ ${#SCENARIOS[@]} -eq 0 ]]; then SCENARIOS=(launch switch messages paging); fi
for scenario in "${SCENARIOS[@]}"; do
    case "$scenario" in
        launch|switch|messages|paging|idle) ;;
        *) echo "Unknown scenario: $scenario. Use launch, switch, messages, paging or idle." >&2; exit 2 ;;
    esac
done
if curl -s -o /dev/null --max-time 1 "$SERVER"; then
    echo "Port $PORT is already in use. Set TOY_BOX_PERF_PORT to a free port." >&2
    exit 1
fi

LOGS="$(mktemp -d)"
FIXTURE=""
stop_fixture() {
    if [[ -n "$FIXTURE" ]]; then
        kill "$FIXTURE" 2>/dev/null || true
        wait "$FIXTURE" 2>/dev/null || true
        FIXTURE=""
    fi
}
cleanup() {
    stop_fixture
    for pid in $(pgrep -f "^$BIN" || true); do kill "$pid" 2>/dev/null || true; done
    rm -rf "$LOGS"
}
trap cleanup EXIT
trap 'exit 130' INT TERM

echo "Building a release bundle in $BUILD"
if ! CONFIGURATION=release SCRATCH_PATH="$BUILD" "$ROOT/script/run" --no-open >"$LOGS/build.log" 2>&1; then
    grep -E 'error:' "$LOGS/build.log" >&2 || tail -n 40 "$LOGS/build.log" >&2
    exit 1
fi
rm -rf "$APP"
ditto "$BUILD/Toy Box Desktop.app" "$APP"
# Its own bundle ID keeps the benchmark's defaults and windows apart from every other copy.
/usr/libexec/PlistBuddy -c "Set :CFBundleIdentifier $ID" -c "Set :CFBundleName $NAME" \
    -c "Set :CFBundleDisplayName $NAME" "$APP/Contents/Info.plist"
codesign --force --sign - "$APP" 2>/dev/null

over=0
failed=0
for scenario in "${SCENARIOS[@]}"; do
    case "$scenario" in
        switch) channel=studio-demo ;;
        *) channel=history-demo ;;
    esac
    # Every scenario starts from the same window layout and settings.
    defaults delete "$ID" >/dev/null 2>&1 || true
    TOY_BOX_PERF_PORT="$PORT" bun "$ROOT/script/perf-demo.mjs" "$REFERENCE" >"$LOGS/fixture.log" 2>&1 &
    FIXTURE=$!
    for _ in {1..100}; do
        if curl -sf -o /dev/null --max-time 1 "$SERVER/api/v1/channels"; then break; fi
        if ! kill -0 "$FIXTURE" 2>/dev/null; then break; fi
        sleep 0.1
    done
    if ! curl -sf -o /dev/null --max-time 1 "$SERVER/api/v1/channels"; then
        echo "The fixture didn't start on port $PORT." >&2
        cat "$LOGS/fixture.log" >&2
        exit 1
    fi

    out="$LOGS/$scenario.out"
    err="$LOGS/$scenario.err"
    : >"$out"
    : >"$err"
    # open -W doesn't pass on the app's exit status, so the results come from its output.
    open -n -g -W --stdout "$out" --stderr "$err" "$APP" --args --server "$SERVER" --channel "$channel" \
        --benchmark "$scenario" -ApplePersistenceIgnoreState YES
    stop_fixture

    grep -E '^(Benchmark |  )' "$out" | grep -v '^Benchmark failed' || true
    if grep -q '^Benchmark failed' "$err"; then
        grep '^Benchmark failed' "$err" >&2
        failed=$((failed + 1))
    elif ! grep -q '^Benchmark ' "$out"; then
        echo "Benchmark failed: $scenario printed no results" >&2
        tail -n 20 "$err" >&2
        failed=$((failed + 1))
    fi
    over=$((over + $(grep -c ' OVER$' "$out" || true)))
done

if [[ $failed -gt 0 || $over -gt 0 ]]; then
    echo "$over over budget, $failed failed"
    exit 1
fi
echo "Every result is within budget"
