#!/bin/bash
# Builds a release bundle and measures it against script/perf-demo.mjs, with a fresh fixture and app
# instance for each scenario, then prints every result beside its budget.
# Usage: SCRATCH_PATH=/tmp/tbm-<you> script/benchmark [--summaries] [launch|switch|messages|paging|scroll|key|idle ...]
# Without scenarios it runs launch, switch, messages, paging and scroll. scroll reports hover only
# while the pointer rests over the window, and says whether it did. idle takes a minute, and key takes
# focus for about 45 seconds to measure a key window, so each runs only when named. Don't type while
# key runs. Catch-up summaries stay off, because the on-device model lands one at an unpredictable
# moment and its card animates the transcript during whichever measurement is running. --summaries
# leaves them on to measure the card. Other scenarios open the window in front without taking focus.
# Keep it uncovered while it runs. Exits 1 when a result is over budget or a scenario fails.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SCRATCH="${SCRATCH_PATH:?Set SCRATCH_PATH=/tmp/tbm-<you>}"
# A sibling scratch path keeps the release build from replacing the debug one.
BUILD="${SCRATCH%/}-benchmark"
REFERENCE="${TOY_BOX_REFERENCE:-$ROOT/../toy-box-Minecraft}"
PORT="${TOY_BOX_PERF_PORT:-3292}"
SERVER="http://127.0.0.1:$PORT"
NAME="Toy Box Desktop Benchmark"
ID="dev.toybox.channels.mac.benchmark"
APP="$BUILD/$NAME.app"

SUMMARIES=NO
SCENARIOS=()
for argument in "$@"; do
    case "$argument" in
        --summaries) SUMMARIES=YES ;;
        launch|switch|messages|paging|scroll|key|idle) SCENARIOS+=("$argument") ;;
        *) echo "Unknown scenario: $argument. Use launch, switch, messages, paging, scroll, key or idle, and --summaries to leave catch-up summaries on." >&2; exit 2 ;;
    esac
done
if [[ ${#SCENARIOS[@]} -eq 0 ]]; then SCENARIOS=(launch switch messages paging scroll); fi

# One benchmark runs at a time on this Mac, because two would measure each other's CPU and share the
# app's defaults. This script's own descriptor holds the lock, so it's released however the script
# ends. Long-lived children close the descriptor so they can't keep holding it.
exec 9>>/tmp/toy-box-benchmark.lock
lock() {
    python3 -c 'import fcntl, sys; fcntl.flock(9, fcntl.LOCK_EX | (fcntl.LOCK_NB if sys.argv[1] == "try" else 0))' "$1" 2>/dev/null
}
if ! lock try; then
    echo "Waiting for another benchmark to finish"
    lock wait
fi

if curl -s -o /dev/null --max-time 1 "$SERVER"; then
    echo "Port $PORT is already in use. Set TOY_BOX_PERF_PORT to a free port." >&2
    exit 1
fi
mkdir -p "$BUILD"
# Running processes report the resolved path, such as /private/tmp for /tmp, so the cleanup matches it.
BIN="$(cd "$BUILD" && pwd -P)/$NAME.app/Contents/MacOS/ToyBoxDesktop"

LOGS="$(mktemp -d)"
FIXTURE=""
stop_fixture() {
    if [[ -n "$FIXTURE" ]]; then
        kill "$FIXTURE" 2>/dev/null || true
        wait "$FIXTURE" 2>/dev/null || true
        FIXTURE=""
    fi
}
cleanup() {
    # An interrupted `open -W` fails first, so set -e starts this cleanup before the INT trap runs.
    # Ignoring the pending INT keeps that trap's exit from cutting the cleanup short of the app.
    trap '' INT TERM
    stop_fixture
    for pid in $(pgrep -f "^$BIN" || true); do kill "$pid" 2>/dev/null || true; done
    rm -rf "$LOGS"
}
trap cleanup EXIT
trap 'exit 130' INT TERM

echo "Building a release bundle in $BUILD"
if ! CONFIGURATION=release SCRATCH_PATH="$BUILD" "$ROOT/script/run" --no-open >"$LOGS/build.log" 2>&1 9>&-; then
    grep -E 'error:' "$LOGS/build.log" >&2 || tail -n 40 "$LOGS/build.log" >&2
    exit 1
fi
rm -rf "$APP"
ditto "$BUILD/Toy Box Desktop.app" "$APP"
# Its own bundle ID keeps the benchmark's defaults and windows apart from every other copy.
/usr/libexec/PlistBuddy -c "Set :CFBundleIdentifier $ID" -c "Set :CFBundleName $NAME" \
    -c "Set :CFBundleDisplayName $NAME" "$APP/Contents/Info.plist"
codesign --force --sign - "$APP" 2>/dev/null

over=0
failed=0
if [[ $SUMMARIES == YES ]]; then echo "Catch-up summaries are on"; fi
for scenario in "${SCENARIOS[@]}"; do
    case "$scenario" in
        switch|key) channel=studio-demo ;;
        scroll) channel=scroll-demo ;;
        *) channel=history-demo ;;
    esac
    # Only key comes forward as the active app, because a key window is what it measures.
    background=-g
    if [[ $scenario == key ]]; then background=""; fi
    # Every scenario starts from the same window layout and settings.
    defaults delete "$ID" >/dev/null 2>&1 || true
    defaults write "$ID" summarizeNewMessages -bool "$SUMMARIES"
    TOY_BOX_PERF_PORT="$PORT" bun "$ROOT/script/perf-demo.mjs" "$REFERENCE" >"$LOGS/fixture.log" 2>&1 9>&- &
    FIXTURE=$!
    for _ in {1..100}; do
        if curl -sf -o /dev/null --max-time 1 "$SERVER/api/v1/channels"; then break; fi
        if ! kill -0 "$FIXTURE" 2>/dev/null; then break; fi
        sleep 0.1
    done
    if ! curl -sf -o /dev/null --max-time 1 "$SERVER/api/v1/channels"; then
        echo "The fixture didn't start on port $PORT." >&2
        cat "$LOGS/fixture.log" >&2
        exit 1
    fi

    out="$LOGS/$scenario.out"
    err="$LOGS/$scenario.err"
    : >"$out"
    : >"$err"
    # open -W doesn't pass on the app's exit status, so the results come from its output.
    open -n ${background:+"$background"} -W --stdout "$out" --stderr "$err" "$APP" --args --server "$SERVER" --channel "$channel" \
        --benchmark "$scenario" -ApplePersistenceIgnoreState YES 9>&-
    stop_fixture

    grep -E '^(Benchmark |  )' "$out" | grep -v '^Benchmark failed' || true
    if grep -q '^Benchmark failed' "$err"; then
        grep '^Benchmark failed' "$err" >&2
        failed=$((failed + 1))
    elif ! grep -q '^Benchmark ' "$out"; then
        echo "Benchmark failed: $scenario printed no results" >&2
        tail -n 20 "$err" >&2
        failed=$((failed + 1))
    fi
    over=$((over + $(grep -c ' OVER$' "$out" || true)))
done

if [[ $failed -gt 0 || $over -gt 0 ]]; then
    echo "$over over budget, $failed failed"
    exit 1
fi
echo "Every result is within budget"
