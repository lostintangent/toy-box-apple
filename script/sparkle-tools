#!/bin/bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
VERSION=2.10.0
CHECKSUM=c2bf58aa8387266ac179357b1415d6f2635f044da8be41042af32425dae6da0c
CACHE="${SPARKLE_TOOLS_DIR:-$ROOT/.build/sparkle-tools/$VERSION}"
if [[ ! -x "$CACHE/bin/generate_appcast" || ! -x "$CACHE/bin/generate_keys" || ! -x "$CACHE/bin/sign_update" ]]; then
    mkdir -p "$CACHE"
    TEMP="$(mktemp -d "$CACHE/.download.XXXXXX")"
    trap 'rm -f "$TEMP/Sparkle.tar.xz"; rmdir "$TEMP"' EXIT
    curl --fail --silent --show-error --location \
        "https://github.com/sparkle-project/Sparkle/releases/download/$VERSION/Sparkle-$VERSION.tar.xz" \
        -o "$TEMP/Sparkle.tar.xz"
    printf '%s  %s\n' "$CHECKSUM" "$TEMP/Sparkle.tar.xz" | shasum -a 256 -c - >&2
    tar -xJf "$TEMP/Sparkle.tar.xz" -C "$CACHE"
fi
printf '%s\n' "$CACHE"
