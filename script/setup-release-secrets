#!/bin/bash
set +x
set -euo pipefail
umask 077

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export DEVELOPER_DIR="${DEVELOPER_DIR:-/Library/Developer/CommandLineTools}"
if [[ $# -lt 4 || $# -gt 5 ]]; then
    echo "Usage: script/setup-release-secrets SHA1 /path/AuthKey.p8 KEY_ID ISSUER_ID [OWNER/REPO]
   or: script/setup-release-secrets SHA1 --apple-id EMAIL TEAM_ID [OWNER/REPO]" >&2
    exit 1
fi
IDENTITY="$1"
[[ "$IDENTITY" =~ ^[[:xdigit:]]{40}$ ]] || { echo "Identity must be a 40-digit SHA-1." >&2; exit 1; }
if [[ "$2" == --apple-id ]]; then
    NOTARY_AUTH=apple-id
    APPLE_ID="$3"
    TEAM_ID="$4"
    [[ -n "$APPLE_ID" && -n "$TEAM_ID" ]] || { echo "Apple ID and Team ID must not be empty." >&2; exit 1; }
else
    NOTARY_AUTH=key
    KEY_FILE="$2"
    KEY_ID="$3"
    ISSUER_ID="$4"
    [[ -r "$KEY_FILE" ]] || { echo "The App Store Connect .p8 file is not readable." >&2; exit 1; }
    [[ -n "$KEY_ID" && -n "$ISSUER_ID" ]] || { echo "Key ID and Issuer ID must not be empty." >&2; exit 1; }
fi
REPO="${5:-$(cd "$ROOT" && gh repo view --json nameWithOwner --jq .nameWithOwner)}"
gh auth status >/dev/null
TEMP="$(mktemp -d "${TMPDIR:-/tmp}/toy-box-release-secrets.XXXXXX")"
cleanup() {
    rm -f "$TEMP/identity.p12"
    rmdir "$TEMP"
    unset P12_PASSWORD APP_PASSWORD
}
trap cleanup EXIT
if [[ "$NOTARY_AUTH" == apple-id ]]; then
    APP_PASSWORD=""
    if ! IFS= read -r -s -p "App-specific password for $APPLE_ID: " APP_PASSWORD && [[ -z "$APP_PASSWORD" ]]; then
        printf '\nUnable to read the app-specific password.\n' >&2
        exit 1
    fi
    printf '\n' >&2
    [[ -n "$APP_PASSWORD" ]] || { echo "The app-specific password must not be empty." >&2; exit 1; }
fi
P12_PASSWORD="$(openssl rand -base64 48)"
export P12_PASSWORD
xcrun swift "$ROOT/script/export-signing-identity.swift" "$IDENTITY" "$TEMP/identity.p12"
if [[ "$NOTARY_AUTH" == apple-id ]]; then
    xcrun notarytool store-credentials toy-box-channels-notary \
        --apple-id "$APPLE_ID" --team-id "$TEAM_ID" --password "$APP_PASSWORD"
else
    xcrun notarytool store-credentials toy-box-channels-notary \
        --key "$KEY_FILE" --key-id "$KEY_ID" --issuer "$ISSUER_ID"
fi
base64 < "$TEMP/identity.p12" | gh secret set MACOS_SIGNING_CERTIFICATE --repo "$REPO"
printf '%s' "$P12_PASSWORD" | gh secret set MACOS_SIGNING_PASSWORD --repo "$REPO"
printf '%s' "$IDENTITY" | gh secret set MACOS_SIGNING_IDENTITY --repo "$REPO"
if [[ "$NOTARY_AUTH" == apple-id ]]; then
    printf '%s' "$APPLE_ID" | gh secret set NOTARY_APPLE_ID --repo "$REPO"
    printf '%s' "$TEAM_ID" | gh secret set NOTARY_TEAM_ID --repo "$REPO"
    printf '%s' "$APP_PASSWORD" | gh secret set NOTARY_APP_PASSWORD --repo "$REPO"
else
    gh secret set APP_STORE_CONNECT_PRIVATE_KEY --repo "$REPO" < "$KEY_FILE"
    printf '%s' "$KEY_ID" | gh secret set APP_STORE_CONNECT_KEY_ID --repo "$REPO"
    printf '%s' "$ISSUER_ID" | gh secret set APP_STORE_CONNECT_ISSUER_ID --repo "$REPO"
fi
echo "Release secrets configured for $REPO. Local notarization profile: toy-box-channels-notary."
