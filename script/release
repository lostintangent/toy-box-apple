#!/bin/bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export DEVELOPER_DIR="${DEVELOPER_DIR:-/Library/Developer/CommandLineTools}"
TAG="${1:?Usage: SIGNING_IDENTITY=SHA1 BUILD_NUMBER=1.1 [NOTARY_PROFILE=name] script/release vX.Y.Z}"
[[ "$TAG" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "Release tag must be vX.Y.Z." >&2; exit 1; }
VERSION="${TAG#v}"
IDENTITY="${SIGNING_IDENTITY:?Set SIGNING_IDENTITY to a Developer ID Application certificate SHA-1.}"
[[ "$IDENTITY" =~ ^[[:xdigit:]]{40}$ ]] || { echo "Signing identity must be a 40-digit SHA-1." >&2; exit 1; }
BUILD="${BUILD_NUMBER:?Set BUILD_NUMBER to a monotonically increasing build number.}"
[[ "$BUILD" =~ ^[1-9][0-9]{0,3}(\.[0-9]{1,2}){0,2}$ ]] || { echo "Build number must use Apple's numeric major[.minor[.patch]] format." >&2; exit 1; }
[[ -s "$ROOT/Resources/AppIcon.icns" ]] || { echo "The release app icon is missing. Run script/icon." >&2; exit 1; }
SCRATCH="${SCRATCH_PATH:-$ROOT/.build/distribution}"
OUTPUT="${OUTPUT_DIR:-$ROOT/dist}"
APP="$SCRATCH/Toy Box Desktop.app"
SIGN_ARGS=(--force --options runtime --timestamp --entitlements "$ROOT/Resources/Release.entitlements" --sign "$IDENTITY")
IDENTITY_ARGS=(-v -p codesigning)
if [[ -n "${SIGNING_KEYCHAIN:-}" ]]; then
    SIGN_ARGS+=(--keychain "$SIGNING_KEYCHAIN")
    IDENTITY_ARGS+=("$SIGNING_KEYCHAIN")
fi
if ! security find-identity "${IDENTITY_ARGS[@]}" | awk -v identity="$IDENTITY" '
    toupper($2) == toupper(identity) && /"Developer ID Application: / { found = 1 }
    END { exit !found }
'; then
    echo "The pinned Developer ID Application identity is unavailable or invalid." >&2
    exit 1
fi

SUFFIX=""
if [[ -z "${NOTARY_PROFILE:-}" ]]; then
    SUFFIX="-SIGNED-UNNOTARIZED"
    echo "WARNING: NOTARY_PROFILE is unset. This is SIGNED ONLY. Gatekeeper will block downloaded copies." >&2
fi
mkdir -p "$OUTPUT"
ARCHIVE="$OUTPUT/ToyBoxDesktop-$VERSION-arm64$SUFFIX.zip"
[[ ! -e "$ARCHIVE" && ! -e "$ARCHIVE.sha256" ]] || { echo "Release output already exists: $ARCHIVE" >&2; exit 1; }
CONFIGURATION=release SCRATCH_PATH="$SCRATCH" "$ROOT/script/run" --no-open
PLIST="$APP/Contents/Info.plist"
/usr/libexec/PlistBuddy -c "Set :CFBundleShortVersionString $VERSION" -c "Set :CFBundleVersion $BUILD" "$PLIST"
if [[ "$(xcrun lipo -archs "$APP/Contents/MacOS/ToyBoxDesktop")" != arm64 ]]; then
    echo "Release executable must contain only arm64." >&2
    exit 1
fi
echo "Signing with the pinned identity. If a keychain prompt appears, allow codesign to use that key."
codesign "${SIGN_ARGS[@]}" "$APP"
codesign --verify --strict --verbose=2 "$APP"
SIGNATURE="$(codesign --display --verbose=4 "$APP" 2>&1)"
if ! grep -q 'flags=.*runtime' <<<"$SIGNATURE"; then
    echo "The release signature is missing hardened runtime." >&2
    exit 1
fi

if [[ -n "${NOTARY_PROFILE:-}" ]]; then
    TEMP="$(mktemp -d "$OUTPUT/.notarization.XXXXXX")"
    cleanup() {
        rm -f "$TEMP/submission.zip" "$TEMP/result.json"
        rmdir "$TEMP"
    }
    trap cleanup EXIT
    ditto -c -k --keepParent "$APP" "$TEMP/submission.zip"
    NOTARY_ARGS=(--keychain-profile "$NOTARY_PROFILE")
    if [[ -n "${NOTARY_KEYCHAIN:-}" ]]; then NOTARY_ARGS+=(--keychain "$NOTARY_KEYCHAIN"); fi
    SUBMISSION_STATUS=0
    xcrun notarytool submit "$TEMP/submission.zip" "${NOTARY_ARGS[@]}" \
        --wait --timeout 30m --output-format json > "$TEMP/result.json" || SUBMISSION_STATUS=$?
    cat "$TEMP/result.json"
    if ! plutil -lint "$TEMP/result.json" >/dev/null; then
        echo "Notarization failed without a valid submission response (exit $SUBMISSION_STATUS)." >&2
        exit 1
    fi
    STATUS="$(plutil -extract status raw -o - "$TEMP/result.json")"
    if [[ "$STATUS" != Accepted || "$SUBMISSION_STATUS" -ne 0 ]]; then
        SUBMISSION_ID="$(plutil -extract id raw -o - "$TEMP/result.json")"
        echo "Notarization was not accepted ($STATUS, submission $SUBMISSION_ID). Fetching its log:" >&2
        if ! xcrun notarytool log "$SUBMISSION_ID" "${NOTARY_ARGS[@]}"; then
            echo "The notarization log could not be fetched. Use submission $SUBMISSION_ID to check it later." >&2
        fi
        echo "No release archive was created." >&2
        exit 1
    fi
    xcrun stapler staple "$APP"
    xcrun stapler validate "$APP"
    codesign --verify --strict --verbose=2 "$APP"
    spctl -a -t exec -vv "$APP"
else
    if ASSESSMENT="$(spctl -a -t exec -vv "$APP" 2>&1)"; then
        printf '%s\n' "$ASSESSMENT"
    else
        printf '%s\n' "$ASSESSMENT" >&2
        if ! grep -q 'source=Unnotarized Developer ID' <<<"$ASSESSMENT"; then
            echo "Gatekeeper failed for a reason other than missing notarization." >&2
            exit 1
        fi
        echo "WARNING: Gatekeeper rejected this unnotarized build as expected. Do not publish it as a normal release." >&2
    fi
fi
ditto -c -k --keepParent "$APP" "$ARCHIVE"
(cd "$OUTPUT" && shasum -a 256 "$(basename "$ARCHIVE")" > "$(basename "$ARCHIVE").sha256")
echo "Release archive: $ARCHIVE"
echo "SHA-256: $ARCHIVE.sha256"
