#!/bin/bash
set +x
set -euo pipefail
umask 077

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
[[ $# -le 1 ]] || { echo "Usage: script/setup-update-secrets [OWNER/REPO]" >&2; exit 1; }
REPO="${1:-$(cd "$ROOT" && gh repo view --json nameWithOwner --jq .nameWithOwner)}"
gh auth status >/dev/null
TOOLS="$("$ROOT/script/sparkle-tools")"
ACCOUNT=dev.toybox.channels.mac
TEMP="$(mktemp -d "${TMPDIR:-/tmp}/toy-box-update-secrets.XXXXXX")"
trap 'rm -f "$TEMP/private-key"; rmdir "$TEMP"' EXIT

# An app-specific account makes reruns reuse this key without touching Sparkle's global key.
"$TOOLS/bin/generate_keys" --account "$ACCOUNT"
PUBLIC_KEY="$("$TOOLS/bin/generate_keys" --account "$ACCOUNT" -p)"
[[ "$PUBLIC_KEY" =~ ^[A-Za-z0-9+/]{43}=$ ]] || { echo "Sparkle returned an invalid public key." >&2; exit 1; }
"$TOOLS/bin/generate_keys" --account "$ACCOUNT" -x "$TEMP/private-key"
gh secret set SPARKLE_ED_PRIVATE_KEY --repo "$REPO" < "$TEMP/private-key"
gh variable set SPARKLE_ED_PUBLIC_KEY --repo "$REPO" --body "$PUBLIC_KEY"
echo "Update signing configured for $REPO. Keep the $ACCOUNT Sparkle key in your Keychain backed up."
