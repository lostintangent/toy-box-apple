#!/bin/bash
# Builds the current tree, refreshes the user's validation bundle, and launches the build in the
# background from the agents' test bundle.
# Usage: SCRATCH_PATH=/tmp/tbm-<you> [SERVER_URL=...] script/validate [--channel ID] [other app arguments]
# The test bundle has its own bundle ID, so Computer Use can drive it while the user's copy of the
# app runs. Instances that share a bundle ID can be read but not clicked.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SCRATCH="${SCRATCH_PATH:?Set SCRATCH_PATH=/tmp/tbm-<you>}"
SERVER="${SERVER_URL:-http://127.0.0.1:3210}"
DIR="$ROOT/.build/validation"
APP="$DIR/Toy Box Channels.app"
TEST_DIR="$ROOT/.build/agents"
TEST_NAME="Toy Box Channels Test"
TEST_ID="dev.toybox.channels.mac.test"
TEST_APP="$TEST_DIR/$TEST_NAME.app"

SCRATCH_PATH="$SCRATCH" "$ROOT/script/run" --no-open >/dev/null

BUILD_VERSION="$(xcrun vtool -show-build "$SCRATCH/Toy Box Channels.app/Contents/MacOS/ToyBoxChannels")"
if ! awk '
    $1 == "sdk" {
        found = 1
        split($2, version, ".")
        if ($2 !~ /^[0-9]+([.][0-9]+)*$/ || version[1] + 0 < 27) invalid = 1
    }
    END { exit(!found || invalid) }
' <<<"$BUILD_VERSION"; then
    echo "Validation requires a bundle stamped with macOS SDK 27 or later." >&2
    echo "$BUILD_VERSION" >&2
    exit 1
fi

# Swap atomically. Running instances, including the user's, keep their unlinked files.
install_bundle() { # <staged app> <destination app>
    local dir old
    dir="$(dirname "$2")"
    old="$(mktemp -d "$dir/.old.XXXXXX")"
    if [[ -e "$2" ]]; then mv "$2" "$old/"; fi
    mv "$1" "$2"
    rm -rf "$old"
}

mkdir -p "$DIR" "$TEST_DIR"
STAGE="$(mktemp -d "$DIR/.stage.XXXXXX")"
ditto "$SCRATCH/Toy Box Channels.app" "$STAGE/Toy Box Channels.app"
install_bundle "$STAGE/Toy Box Channels.app" "$APP"
rm -rf "$STAGE"

TEST_STAGE="$(mktemp -d "$TEST_DIR/.stage.XXXXXX")"
ditto "$SCRATCH/Toy Box Channels.app" "$TEST_STAGE/$TEST_NAME.app"
/usr/libexec/PlistBuddy -c "Set :CFBundleIdentifier $TEST_ID" -c "Set :CFBundleName $TEST_NAME" \
    -c "Set :CFBundleDisplayName $TEST_NAME" "$TEST_STAGE/$TEST_NAME.app/Contents/Info.plist"
codesign --force --deep --sign - "$TEST_STAGE/$TEST_NAME.app" 2>/dev/null
install_bundle "$TEST_STAGE/$TEST_NAME.app" "$TEST_APP"
rm -rf "$TEST_STAGE"
# Computer Use only targets apps that Launch Services knows about.
/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister \
    -f "$TEST_APP"

# Until the user approves the test bundle for Computer Use, launch the shared validation bundle.
LAUNCH_APP="$TEST_APP"
LAUNCH_ID="$TEST_ID"
if ! grep -q "\"$TEST_ID\"" "$HOME/.copilot/computer-use/approvals.json" 2>/dev/null; then
    LAUNCH_APP="$APP"
    LAUNCH_ID="dev.toybox.channels.mac"
    echo "$TEST_ID isn't approved for Computer Use yet, so this launches the shared bundle." >&2
fi
LAUNCH_BIN="$LAUNCH_APP/Contents/MacOS/ToyBoxChannels"

before="$(pgrep -f "^$LAUNCH_BIN" || true)"
# Test instances must never restore or overwrite saved window state.
open -n -g "$LAUNCH_APP" --args --server "$SERVER" -ApplePersistenceIgnoreState YES "$@"
for _ in {1..50}; do
    for pid in $(pgrep -f "^$LAUNCH_BIN" || true); do
        if ! grep -qx "$pid" <<<"$before"; then
            echo "Launched pid $pid against $SERVER as $LAUNCH_ID. Find its window with list_apps, and kill $pid when done."
            exit 0
        fi
    done
    sleep 0.1
done
echo "The app did not launch." >&2
exit 1
