#!/bin/bash
set -euo pipefail

usage() {
    echo "Usage: script/snapshot --server <url> --channel <id> --appearance light|dark --size 1280x840 --snapshot <file.png> [--state <name>]"
}

if [[ "${1:-}" == "--help" ]]; then
    usage
    exit 0
fi

has_server=false
has_snapshot=false
for argument in "$@"; do
    case "$argument" in
        --server) has_server=true ;;
        --snapshot) has_snapshot=true ;;
    esac
done
if [[ "$has_server" != true || "$has_snapshot" != true ]]; then
    usage >&2
    echo "Snapshot rendering requires an explicit server and PNG destination." >&2
    exit 64
fi

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SCRATCH="${SCRATCH_PATH:-$ROOT/.build}"
SCRATCH_PATH="$SCRATCH" "$ROOT/script/run" --no-open >&2
exec "$SCRATCH/Toy Box Desktop.app/Contents/MacOS/ToyBoxDesktop" "$@"
