#!/bin/bash
set -euo pipefail

SOURCE="${1:?Usage: script/embed-sparkle FRAMEWORK APP LICENSE}"
APP="${2:?Provide the destination app.}"
LICENSE="${3:?Provide the Sparkle license.}"
FRAMEWORK="$APP/Contents/Frameworks/Sparkle.framework"
[[ -f "$SOURCE/Sparkle" && -s "$LICENSE" ]] || { echo "Sparkle framework or license is missing." >&2; exit 1; }
mkdir -p "$APP/Contents/Frameworks" "$APP/Contents/Resources"
rm -rf "$FRAMEWORK"
ditto "$SOURCE" "$FRAMEWORK"
install -m 644 "$LICENSE" "$APP/Contents/Resources/Sparkle-LICENSE"

# These services are only needed by sandboxed hosts. Keep the in-process installer and updater.
for component in XPCServices Headers PrivateHeaders Modules; do
    rm -rf "$FRAMEWORK/$component" "$FRAMEWORK/Versions/Current/$component"
done
for executable in "$FRAMEWORK/Versions/Current/Sparkle" \
    "$FRAMEWORK/Versions/Current/Autoupdate" \
    "$FRAMEWORK/Versions/Current/Updater.app/Contents/MacOS/Updater"; do
    if [[ "$(xcrun lipo -archs "$executable")" != arm64 ]]; then
        xcrun lipo "$executable" -thin arm64 -output "$executable.arm64"
        mv "$executable.arm64" "$executable"
        chmod +x "$executable"
    fi
done
