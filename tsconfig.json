{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "types": ["bun"],
    "skipLibCheck": true
  },
  "include": [
    "scripts/shared/**/*.ts",
    "scripts/fixtures/**/*.ts",
    "scripts/desktop/**/*.ts",
    "scripts/mobile/**/*.ts"
  ]
}
